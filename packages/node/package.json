{
  "name": "rootcast",
  "version": "0.1.0",
  "description": "The flight recorder for AI agents. Find where an agent went wrong and why.",
  "license": "Apache-2.0",
  "author": "Amaresh Hebbar <hebbar.gvamaresh@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rootcast": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "release:check": "node scripts/release_check.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "debugging",
    "observability",
    "root-cause",
    "replay",
    "llm",
    "tracing",
    "causal-analysis"
  ],
  "homepage": "https://github.com/amareshhebbar/RootCast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amareshhebbar/RootCast.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/amareshhebbar/RootCast/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.11.0"
  }
}

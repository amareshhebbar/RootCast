{
  "name": "rootcast",
  "version": "0.1.0",
  "description": "The flight recorder for AI agents. Find where an agent went wrong and why.",
  "license": "Apache-2.0",
  "author": "Amaresh Hebbar <hebbar.gvamaresh@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rootcast": "dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["ai", "agents", "debugging", "observability", "root-cause", "replay", "llm"],
  "repository": {
    "type": "git",
    "url": "https://github.com/amareshhebbar/rootcast"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.11.0"
  }
}
